NODE_ENV=development
PORT=8090
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/medsecure?retryWrites=true&w=majority
MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
MONGO_SKIP_REMOTE_IN_DEV=false
ALLOW_START_WITHOUT_DB=true
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
GOOGLE_CLIENT_ID=google-client-id
GOOGLE_CLIENT_SECRET=google-client-secret
